<script>
  /* ====== EDIT THESE ====== */
  // WhatsApp number: international format, digits only (Nigeria: 234 + number without the leading 0).
  // You can also change it later in the Dashboard > Settings.
  var WHATSAPP = "2340000000000";
  // First-time dashboard PIN. Change it in Dashboard > Settings.
  var DEFAULT_PIN = "1234";
  // Photos: put images in an "images" folder next to index.html, named after the product id, e.g. images/garri-white.jpg
  // perKg = naira per kg. sizes are in kg (0.5 = 500 g). color = grain color on the fallback sack drawing.
  var PRODUCTS = [
    { id: "garri-white",  name: "White garri",         cat: "Garri",            perKg: 1800, sizes: [1, 5, 25, 50], color: "#F7F0D2", desc: "Crisp, sun-dried white garri for eba and soaking." },
    { id: "garri-yellow", name: "Yellow garri",        cat: "Garri",            perKg: 2000, sizes: [1, 5, 25, 50], color: "#F2B400", desc: "Palm-oil rich yellow garri with a fuller taste." },
    { id: "garri-ijebu",  name: "Ijebu garri",         cat: "Garri",            perKg: 2200, sizes: [1, 5, 25, 50], color: "#EADFB0", desc: "Fine, sour-edged grains that swell well in water." },
    { id: "yam-flour",    name: "Yam flour (elubo)",   cat: "Flours",           perKg: 2500, sizes: [1, 5, 25],     color: "#CDB48E", desc: "Milled dry yam for smooth amala." },
    { id: "pounded-yam",  name: "Pounded yam flour",   cat: "Flours",           perKg: 3000, sizes: [1, 5, 25],     color: "#F1E6D2", desc: "Instant flour. Stir into hot water and serve." },
    { id: "cassava-flour",name: "Cassava flour",       cat: "Flours",           perKg: 1600, sizes: [1, 5, 25],     color: "#F8F4E8", desc: "Fine flour for fufu, baking and swallows." },
    { id: "rice-local",   name: "Local rice",          cat: "Rice and grains",  perKg: 2300, sizes: [1, 5, 25, 50], color: "#F4F0DC", desc: "Stone-free local rice, bagged for the pot." },
    { id: "maize",        name: "Dry maize",           cat: "Rice and grains",  perKg: 900,  sizes: [1, 5, 25, 50], color: "#E5A812", desc: "Dry yellow and white maize for milling or pap." },
    { id: "millet",       name: "Millet",              cat: "Rice and grains",  perKg: 1500, sizes: [1, 5, 25],     color: "#D9B24C", desc: "Whole millet for fura, kunu and porridge." },
    { id: "sorghum",      name: "Guinea corn",         cat: "Rice and grains",  perKg: 1200, sizes: [1, 5, 25, 50], color: "#A9472A", desc: "Sorghum grain for pap, kunu and brewing." },
    { id: "beans-brown",  name: "Brown beans",         cat: "Beans and nuts",   perKg: 2600, sizes: [1, 5, 25, 50], color: "#7A4326", desc: "Sorted brown beans with a rich flavour." },
    { id: "beans-white",  name: "White beans",         cat: "Beans and nuts",   perKg: 2800, sizes: [1, 5, 25, 50], color: "#F0E7CF", desc: "Soft-cooking white beans for moi moi and akara." },
    { id: "soybeans",     name: "Soybeans",            cat: "Beans and nuts",   perKg: 1800, sizes: [1, 5, 25, 50], color: "#D9C479", desc: "Clean dry soybeans for milk, flour and feed mixes." },
    { id: "groundnut",    name: "Groundnut (shelled)", cat: "Beans and nuts",   perKg: 3500, sizes: [1, 5, 25],     color: "#C98B50", desc: "Raw shelled groundnuts for roasting or oil." },
    { id: "sesame",       name: "Sesame (beniseed)",   cat: "Seeds and spices", perKg: 3200, sizes: [1, 5, 25, 50], color: "#EFE3BF", desc: "Clean sesame seed, a Benue speciality." },
    { id: "egusi",        name: "Egusi (melon seed)",  cat: "Seeds and spices", perKg: 6000, sizes: [0.5, 1, 5],    color: "#D8C677", desc: "Shelled melon seed for soups." },
    { id: "ginger",       name: "Dried ginger",        cat: "Seeds and spices", perKg: 5000, sizes: [0.5, 1, 5],    color: "#C9994A", desc: "Split dried ginger for tea, spice and powder." },
    { id: "pepper",       name: "Dried pepper",        cat: "Seeds and spices", perKg: 7000, sizes: [0.5, 1, 5],    color: "#C0281C", desc: "Hot dried pepper for stews and grinding." }
  ];
  /* ======================== */

  function $(s) { return document.querySelector(s); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); }
  function fmt(n) { return "₦" + Math.round(n).toLocaleString("en-NG"); }
  function sizeLabel(kg) { return kg < 1 ? (kg * 1000) + " g" : kg + " kg"; }
  function find(id) { for (var i = 0; i < PRODUCTS.length; i++) if (PRODUCTS[i].id === id) return PRODUCTS[i]; }
  function defaultSize(p) { return p.sizes.length > 1 ? p.sizes[1] : p.sizes[0]; }

  /* ---- Saved data (stays on this device/browser) ---- */
  var KEY = "shesh911_benue_store_v1", mem = null;
  function loadStore() {
    var d = null;
    try { d = JSON.parse(localStorage.getItem(KEY)); } catch (e) {}
    if (!d) d = mem;
    d = d || {};
    d.prices = d.prices || {}; d.stock = d.stock || {}; d.orders = d.orders || [];
    d.whatsapp = d.whatsapp || ""; d.pin = d.pin || DEFAULT_PIN;
    return d;
  }
  var store = loadStore();
  function save() { mem = store; try { localStorage.setItem(KEY, JSON.stringify(store)); } catch (e) {} }
  function perKg(p) { return store.prices[p.id] !== undefined ? store.prices[p.id] : p.perKg; }
  function inStock(p) { return store.stock[p.id] !== false; }
  function priceFor(p, kg) { return perKg(p) * kg; }
  function waNumber() { return store.whatsapp || WHATSAPP; }
  function waUrl(text) { return "https://wa.me/" + waNumber() + (text ? "?text=" + encodeURIComponent(text) : ""); }
  function setLinks() {
    var u = waUrl("Hello Shesh911 Benue Store, I have a question.");
    ["#topWhatsapp", "#heroWhatsapp", "#contactWhatsapp"].forEach(function (s) { $(s).href = u; });
  }

  var cart = {}, activeCat = "All", query = "", lastFocus = null;

  /* ---- Fallback sack drawing (shown until you add a photo) ---- */
  function sack(p) {
    var short = p.name.split(" (")[0];
    var label = short.length > 13 ? short.slice(0, 12) + "." : short;
    var uid = "b" + p.id.replace(/[^a-z0-9]/g, "");
    return '<svg class="sack" viewBox="0 0 160 160" role="img" aria-label="Sack of ' + esc(p.name) + '">' +
      '<defs><pattern id="' + uid + '" width="6" height="6" patternUnits="userSpaceOnUse"><rect width="6" height="6" fill="#CDA86A"/><path d="M0 3H6M3 0V6" stroke="#B88F52" stroke-width="1"/></pattern></defs>' +
      '<ellipse cx="80" cy="150" rx="52" ry="7" fill="rgba(0,0,0,.15)"/>' +
      '<path d="M42 50 Q80 8 118 50 Q80 66 42 50Z" fill="' + p.color + '" stroke="rgba(0,0,0,.2)" stroke-width="1.5"/>' +
      '<path d="M32 56 Q80 40 128 56 L136 128 Q137 146 118 148 L42 148 Q23 146 24 128Z" fill="url(#' + uid + ')" stroke="#8C6A38" stroke-width="2"/>' +
      '<path d="M32 62 Q80 46 128 62" fill="none" stroke="#7B5B2E" stroke-width="2" stroke-dasharray="5 4"/>' +
      '<rect x="44" y="82" width="72" height="42" rx="3" fill="#FBF7E8" stroke="#2A3A2C" stroke-width="2"/>' +
      '<rect x="44" y="82" width="72" height="9" fill="#0F3D2B"/>' +
      '<text x="80" y="89.5" font-size="6.5" font-weight="700" fill="#D4AF55" text-anchor="middle" font-family="Georgia,serif">SHESH911 BENUE</text>' +
      '<text x="80" y="109" font-size="' + (label.length > 9 ? 10 : 12) + '" font-weight="700" fill="#0F3D2B" text-anchor="middle" font-family="Georgia,serif">' + esc(label) + '</text>' +
      '<text x="80" y="119" font-size="6" font-weight="700" fill="#55645A" text-anchor="middle" font-family="Arial,sans-serif">' + esc(p.cat.toUpperCase()) + '</text></svg>';
  }
  // Tries images/<id>.jpg, then .png, then .jpeg, then .webp; removes itself if none exist so the sack shows.
  var PHOTO_ERR = "var t=this.getAttribute('data-try')|0,x=['.png','.jpeg','.webp'];if(t<x.length){this.setAttribute('data-try',t+1);this.src=this.src.replace(/\\.[a-z]+$/,x[t]);}else{this.remove();}";

  /* ---- Filters + menu ---- */
  var cats = ["All"];
  PRODUCTS.forEach(function (p) { if (cats.indexOf(p.cat) < 0) cats.push(p.cat); });
  function setCat(c) {
    activeCat = c;
    var all = $("#chips").querySelectorAll(".chip");
    for (var i = 0; i < all.length; i++) all[i].setAttribute("aria-pressed", all[i].getAttribute("data-cat") === c);
    renderGrid();
  }
  $("#chips").innerHTML = cats.map(function (c) {
    return '<button class="chip" type="button" aria-pressed="' + (c === activeCat) + '" data-cat="' + esc(c) + '">' + esc(c) + '</button>';
  }).join("");
  $("#chips").addEventListener("click", function (e) { var b = e.target.closest(".chip"); if (b) setCat(b.getAttribute("data-cat")); });
  $("#menuCats").innerHTML = cats.slice(1).map(function (c) {
    return '<a class="sub" href="#shop" data-menucat="' + esc(c) + '">' + esc(c) + '</a>';
  }).join("");
  $("#q").addEventListener("input", function (e) { query = e.target.value.trim().toLowerCase(); renderGrid(); });

  /* ---- Product grid ---- */
  function renderGrid() {
    var list = PRODUCTS.filter(function (p) {
      return (activeCat === "All" || p.cat === activeCat) &&
        (!query || (p.name + " " + p.cat + " " + p.desc).toLowerCase().indexOf(query) > -1);
    });
    if (!list.length) { $("#grid").innerHTML = '<div class="empty">No products match that search. Try another word, or ask for it on WhatsApp.</div>'; return; }
    $("#grid").innerHTML = list.map(function (p) {
      var first = defaultSize(p), ok = inStock(p);
      var bulk = p.sizes[p.sizes.length - 1] >= 25;
      return '<article class="card" data-id="' + p.id + '">' +
        '<div class="art">' + (bulk ? '<span class="badge">Bulk available</span>' : '') + (ok ? '' : '<span class="badge out">Out of stock</span>') +
          sack(p) + '<img class="photo" src="images/' + p.id + '.jpg" alt="' + esc(p.name) + '" loading="lazy" onerror="' + PHOTO_ERR + '"></div>' +
        '<div class="card-body">' +
          '<div><h3>' + esc(p.name) + '</h3><div class="cat">' + esc(p.cat) + '</div></div>' +
          '<p class="desc">' + esc(p.desc) + '</p>' +
          '<div class="buy">' +
            '<div class="price" data-price>' + fmt(priceFor(p, first)) + ' <small>for ' + sizeLabel(first) + '</small></div>' +
            '<label class="sr-only" for="sz-' + p.id + '">Size for ' + esc(p.name) + '</label>' +
            '<select id="sz-' + p.id + '" data-size' + (ok ? '' : ' disabled') + '>' +
              p.sizes.map(function (s) { return '<option value="' + s + '"' + (s === first ? ' selected' : '') + '>' + sizeLabel(s) + ', ' + fmt(priceFor(p, s)) + '</option>'; }).join("") +
            '</select>' +
            '<button class="btn" type="button" data-add' + (ok ? '' : ' disabled') + '>' + (ok ? 'Add to cart' : 'Unavailable') + '</button>' +
          '</div></div></article>';
    }).join("");
  }
  $("#grid").addEventListener("change", function (e) {
    var sel = e.target.closest("[data-size]"); if (!sel) return;
    var card = sel.closest(".card"), p = find(card.getAttribute("data-id")), kg = parseFloat(sel.value);
    card.querySelector("[data-price]").innerHTML = fmt(priceFor(p, kg)) + ' <small>for ' + sizeLabel(kg) + '</small>';
  });
  $("#grid").addEventListener("click", function (e) {
    var btn = e.target.closest("[data-add]"); if (!btn || btn.disabled) return;
    var card = btn.closest(".card"), p = find(card.getAttribute("data-id"));
    var kg = parseFloat(card.querySelector("[data-size]").value), key = p.id + "|" + kg;
    cart[key] = (cart[key] || 0) + 1;
    updateCart(); toast(p.name + ", " + sizeLabel(kg) + " added to cart");
  });

  /* ---- Cart ---- */
  function cartLines() {
    return Object.keys(cart).map(function (key) {
      var parts = key.split("|"), p = find(parts[0]), size = parseFloat(parts[1]), qty = cart[key];
      return { key: key, p: p, size: size, qty: qty, total: priceFor(p, size) * qty };
    });
  }
  function updateCart() {
    var lines = cartLines(), count = 0, sub = 0;
    lines.forEach(function (l) { count += l.qty; sub += l.total; });
    $("#cartCount").textContent = count; $("#subtotal").textContent = fmt(sub);
    $("#cartFoot").style.display = lines.length ? "" : "none";
    if (!lines.length) { $("#cartBody").innerHTML = '<div class="empty">Your cart is empty. Add a product to start your order.</div>'; return; }
    $("#cartBody").innerHTML = lines.map(function (l) {
      return '<div class="line-item" data-key="' + l.key + '">' +
        '<div><div class="t">' + esc(l.p.name) + '</div><div class="s">' + sizeLabel(l.size) + ' bag, ' + fmt(priceFor(l.p, l.size)) + ' each</div></div>' +
        '<div class="p">' + fmt(l.total) + '</div>' +
        '<div class="qty" role="group" aria-label="Quantity of ' + esc(l.p.name) + '"><button type="button" data-dec aria-label="Decrease quantity">&minus;</button><span>' + l.qty + '</span><button type="button" data-inc aria-label="Increase quantity">+</button></div>' +
        '<div style="text-align:right"><button class="link-btn" type="button" data-remove>Remove</button></div></div>';
    }).join("");
  }
  $("#cartBody").addEventListener("click", function (e) {
    var row = e.target.closest(".line-item"); if (!row) return;
    var key = row.getAttribute("data-key");
    if (e.target.closest("[data-inc]")) cart[key]++;
    else if (e.target.closest("[data-dec]")) { cart[key]--; if (cart[key] <= 0) delete cart[key]; }
    else if (e.target.closest("[data-remove]")) delete cart[key];
    else return;
    updateCart();
  });
  function openCart() { lastFocus = document.activeElement; $("#drawer").classList.add("open"); $("#overlay").classList.add("open"); document.body.style.overflow = "hidden"; $("#closeCart").focus(); }
  function closeCart() { $("#drawer").classList.remove("open"); $("#overlay").classList.remove("open"); document.body.style.overflow = ""; if (lastFocus) lastFocus.focus(); }
  $("#openCart").addEventListener("click", openCart);
  $("#closeCart").addEventListener("click", closeCart);
  $("#overlay").addEventListener("click", closeCart);

  $("#sendOrder").addEventListener("click", function () {
    var name = $("#cName").value.trim(), phone = $("#cPhone").value.trim(), addr = $("#cAddr").value.trim();
    var err = $("#formError"), lines = cartLines();
    if (!lines.length) { err.textContent = "Your cart is empty."; return; }
    if (!name || !phone || !addr) { err.textContent = "Enter your name, phone number and delivery address."; return; }
    err.textContent = "";
    var sub = 0; lines.forEach(function (l) { sub += l.total; });
    var msg = ["Hello Shesh911 Benue Store, I would like to order:", ""]
      .concat(lines.map(function (l) { return l.qty + " x " + l.p.name + ", " + sizeLabel(l.size) + " = " + fmt(l.total); }))
      .concat(["", "Subtotal: " + fmt(sub), "", "Name: " + name, "Phone: " + phone, "Delivery address: " + addr, "", "Please confirm the final price and delivery cost."]).join("\n");
    store.orders.push({ t: Date.now(), name: name, phone: phone, addr: addr, total: sub,
      lines: lines.map(function (l) { return { n: l.p.name, s: l.size, q: l.qty, t: l.total }; }) });
    save();
    window.open(waUrl(msg), "_blank");
  });

  /* ---- Dropdown menu ---- */
  var menuBtn = $("#menuBtn"), menuPanel = $("#menuPanel");
  function menuOpen(open) { menuPanel.hidden = !open; menuBtn.setAttribute("aria-expanded", open); }
  menuBtn.addEventListener("click", function (e) { e.stopPropagation(); menuOpen(menuPanel.hidden); });
  menuPanel.addEventListener("click", function (e) {
    var c = e.target.closest("[data-menucat]");
    if (c) setCat(c.getAttribute("data-menucat"));
    if (c || e.target.closest("[data-close]")) menuOpen(false);
  });
  document.addEventListener("click", function (e) { if (!e.target.closest("#dd")) menuOpen(false); });
  document.addEventListener("keydown", function (e) {
    if (e.key !== "Escape") return;
    menuOpen(false);
    if ($("#drawer").classList.contains("open")) closeCart();
    if (!$("#dash").hidden) closeDash();
  });

  /* ---- Dashboard ---- */
  var unlocked = false;
  function openDash() {
    menuOpen(false); lastFocus = document.activeElement;
    $("#dash").hidden = false; document.body.style.overflow = "hidden";
    $("#dashGate").hidden = unlocked; $("#dashApp").hidden = !unlocked;
    if (unlocked) renderDash(); else { $("#pin").value = ""; $("#pinError").textContent = ""; $("#pin").focus(); }
  }
  function closeDash() { $("#dash").hidden = true; document.body.style.overflow = ""; if (lastFocus) lastFocus.focus(); }
  $("#openDash").addEventListener("click", openDash);
  $("#closeDash").addEventListener("click", closeDash);
  function tryUnlock() {
    if ($("#pin").value === store.pin) { unlocked = true; $("#dashGate").hidden = true; $("#dashApp").hidden = false; renderDash(); }
    else $("#pinError").textContent = "Incorrect PIN.";
  }
  $("#unlock").addEventListener("click", tryUnlock);
  $("#pin").addEventListener("keydown", function (e) { if (e.key === "Enter") tryUnlock(); });
  $("#dashApp").addEventListener("click", function (e) {
    var t = e.target.closest(".tab"); if (!t) return;
    var all = document.querySelectorAll(".tab");
    for (var i = 0; i < all.length; i++) {
      var on = all[i] === t;
      all[i].setAttribute("aria-selected", on);
      $("#tab-" + all[i].getAttribute("data-tab")).hidden = !on;
    }
  });

  function renderDash() {
    var orders = store.orders, total = 0, stocked = 0;
    orders.forEach(function (o) { total += o.total; });
    PRODUCTS.forEach(function (p) { if (inStock(p)) stocked++; });

    $("#tab-overview").innerHTML =
      '<div class="kpis">' +
        '<div class="kpi"><b>' + orders.length + '</b><span>Orders sent to WhatsApp</span></div>' +
        '<div class="kpi"><b>' + fmt(total) + '</b><span>Total value of those orders</span></div>' +
        '<div class="kpi"><b>' + stocked + ' of ' + PRODUCTS.length + '</b><span>Products in stock</span></div>' +
        '<div class="kpi"><b>' + esc(waNumber()) + '</b><span>WhatsApp number in use</span></div>' +
      '</div>' +
      '<div class="panel"><h3>Notes</h3><p class="fine" style="margin-top:.5rem">Orders are logged when a customer taps "Send order on WhatsApp" on this device. They show intent to buy, not confirmed payment. This dashboard saves data in this browser only.</p></div>';

    $("#tab-products").innerHTML = '<div class="panel"><div class="prow head"><span>Product</span><span>Price per kg (₦)</span><span>In stock</span></div>' +
      PRODUCTS.map(function (p) {
        return '<div class="prow" data-pid="' + p.id + '"><span>' + esc(p.name) + '</span>' +
          '<input type="number" min="0" step="10" inputmode="numeric" value="' + perKg(p) + '" aria-label="Price per kg for ' + esc(p.name) + '">' +
          '<label class="tg"><input type="checkbox" ' + (inStock(p) ? 'checked' : '') + ' aria-label="In stock: ' + esc(p.name) + '"></label></div>';
      }).join("") + '</div>';

    var ol = orders.slice().reverse();
    $("#tab-orders").innerHTML = '<div class="panel">' + (ol.length ? ol.map(function (o) {
      return '<div class="order"><b>' + esc(o.name) + '</b> <span class="meta">' + esc(o.phone) + ', ' + new Date(o.t).toLocaleString() + '</span>' +
        '<div class="meta">' + esc(o.addr) + '</div><ul>' +
        o.lines.map(function (l) { return '<li>' + l.q + ' x ' + esc(l.n) + ', ' + sizeLabel(l.s) + ' (' + fmt(l.t) + ')</li>'; }).join("") +
        '</ul><b>Total: ' + fmt(o.total) + '</b></div>';
    }).join("") : '<div class="empty" style="border:0">No orders logged yet.</div>') +
      (ol.length ? '<p style="margin-top:1rem"><button class="btn btn-outline btn-small" id="clearOrders">Clear order log</button></p>' : '') + '</div>';

    $("#tab-settings").innerHTML = '<div class="panel">' +
      '<div class="field"><label for="sWa">WhatsApp number (digits only, e.g. 2348012345678)</label><input id="sWa" type="text" inputmode="numeric" value="' + esc(store.whatsapp) + '" placeholder="' + esc(WHATSAPP) + '"></div>' +
      '<div class="field"><label for="sPin">New PIN (4 to 8 digits, leave blank to keep current)</label><input id="sPin" type="password" inputmode="numeric"></div>' +
      '<div class="error" id="sErr" role="alert"></div>' +
      '<button class="btn" id="saveSettings">Save settings</button> ' +
      '<button class="btn btn-outline" id="resetAll">Reset prices and stock</button>' +
      '<p class="fine">The PIN only hides this screen. It is not real security, because the data and code live in the browser. For multi-device access you need a backend.</p></div>';
  }

  $("#tab-products").addEventListener("change", function (e) {
    var row = e.target.closest(".prow"); if (!row) return;
    var id = row.getAttribute("data-pid");
    if (e.target.type === "checkbox") store.stock[id] = e.target.checked;
    else { var v = parseFloat(e.target.value); if (isFinite(v) && v >= 0) store.prices[id] = v; }
    save(); renderGrid(); updateCart(); toast("Saved");
  });
  $("#tab-orders").addEventListener("click", function (e) {
    if (e.target.id === "clearOrders" && confirm("Clear all logged orders on this device?")) { store.orders = []; save(); renderDash(); showTab("orders"); }
  });
  $("#tab-settings").addEventListener("click", function (e) {
    if (e.target.id === "saveSettings") {
      var wa = $("#sWa").value.replace(/\s|\+/g, ""), pin = $("#sPin").value, err = $("#sErr");
      if (wa && !/^\d{10,15}$/.test(wa)) { err.textContent = "WhatsApp number must be 10 to 15 digits, with country code."; return; }
      if (pin && !/^\d{4,8}$/.test(pin)) { err.textContent = "PIN must be 4 to 8 digits."; return; }
      err.textContent = ""; store.whatsapp = wa; if (pin) store.pin = pin;
      save(); setLinks(); renderDash(); showTab("settings"); toast("Settings saved");
    }
    if (e.target.id === "resetAll" && confirm("Reset all prices and stock to the defaults?")) {
      store.prices = {}; store.stock = {}; save(); renderGrid(); updateCart(); renderDash(); showTab("settings"); toast("Reset done");
    }
  });
  function showTab(name) {
    var all = document.querySelectorAll(".tab");
    for (var i = 0; i < all.length; i++) {
      var on = all[i].getAttribute("data-tab") === name;
      all[i].setAttribute("aria-selected", on); $("#tab-" + all[i].getAttribute("data-tab")).hidden = !on;
    }
  }

  /* ---- Hero photo + official emblem (both optional) ---- */
  (function () {
    var h = new Image();
    h.onload = function () { var ph = document.createElement("img"); ph.className = "photo"; ph.alt = "Shesh911 Benue Store produce"; ph.src = h.src; $("#heroVisual").style.minHeight = "300px"; $("#heroVisual").appendChild(ph); };
    h.src = "images/hero.jpg";
    var em = new Image();
    em.onload = function () {
      $("#wmGroup").innerHTML = '<image href="images/benue-emblem.png" x="190" y="-25" width="270" height="270" preserveAspectRatio="xMidYMid meet"/>';
    };
    em.src = "images/benue-emblem.png";
  })();

  var tt;
  function toast(text) { var t = $("#toast"); t.textContent = text; t.classList.add("show"); clearTimeout(tt); tt = setTimeout(function () { t.classList.remove("show"); }, 1800); }

  $("#yr").textContent = new Date().getFullYear();
  $("#statCount").textContent = PRODUCTS.length;
  setLinks(); renderGrid(); updateCart();
</script>
</body>
</html>
