<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Shesh911 Benue Store | Agricultural produce from Benue State</title>
<meta name="description" content="Garri, rice, beans, flours, sesame and other non-perishable agricultural produce from Benue State. Retail and bulk supply. Order on WhatsApp.">
<link rel="icon" href="logo.svg" type="image/svg+xml">
<style>
  :root {
    --bg: #F7F7F3;
    --surface: #FFFFFF;
    --ink: #17231C;
    --muted: #55645A;
    --line: #DADFD3;
    --green: #0F3D2B;
    --green-2: #165239;
    --gold: #B08A2E;
    --gold-soft: #D4AF55;
    --btn: #0F3D2B;
    --btn-ink: #FFFFFF;
    --danger: #B3261E;
    --serif: Georgia, "Times New Roman", serif;
    --shadow: 0 1px 2px rgba(23,35,28,.06), 0 6px 18px -10px rgba(23,35,28,.25);
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0E1612; --surface: #16201A; --ink: #EDF1E9; --muted: #A5B2A8; --line: #263329;
      --btn: #D4AF55; --btn-ink: #1B1400; --gold: #D4AF55; --danger: #FF8A80;
      --shadow: 0 1px 2px rgba(0,0,0,.4), 0 6px 18px -10px rgba(0,0,0,.7);
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; font-size: 16.5px; line-height: 1.6; -webkit-font-smoothing: antialiased; }
  svg { display: block; max-width: 100%; }
  a { color: inherit; }
  :focus-visible { outline: 3px solid var(--gold-soft); outline-offset: 2px; border-radius: 3px; }
  .wrap { width: 100%; max-width: 1180px; margin: 0 auto; padding: 0 1.25rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  h1, h2, h3 { margin: 0; font-family: var(--serif); font-weight: 700; letter-spacing: -0.01em; line-height: 1.15; }
  h1 { font-size: clamp(2.2rem, 6vw, 3.7rem); }
  h2 { font-size: clamp(1.7rem, 4vw, 2.4rem); }
  h3 { font-size: 1.15rem; }
  p { margin: 0; }
  .rule { width: 56px; height: 3px; background: var(--gold); margin: 1rem 0 1.2rem; }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; font: inherit; font-weight: 600; letter-spacing: .01em; padding: .75rem 1.4rem; min-height: 48px; border-radius: 4px; border: 1.5px solid var(--btn); background: var(--btn); color: var(--btn-ink); cursor: pointer; text-decoration: none; }
  .btn:hover { filter: brightness(1.12); }
  .btn-outline { background: transparent; color: var(--ink); border-color: var(--ink); }
  .btn-outline:hover { background: var(--ink); color: var(--bg); filter: none; }
  .btn-gold { background: var(--gold-soft); border-color: var(--gold-soft); color: #1B1400; }
  .btn-small { min-height: 42px; padding: .45rem 1rem; font-size: .95rem; }
  .btn[disabled] { opacity: .5; cursor: not-allowed; filter: none; }

  /* Top bar + header */
  .topbar { background: var(--green); color: #E8EFE6; font-size: .88rem; }
  .topbar .wrap { display: flex; justify-content: space-between; gap: 1rem; padding-top: .45rem; padding-bottom: .45rem; flex-wrap: wrap; }
  .topbar a { color: var(--gold-soft); text-decoration: none; font-weight: 600; }
  header.site { position: sticky; top: 0; z-index: 20; background: var(--surface); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 72px; }
  .brand { display: flex; align-items: center; gap: .75rem; text-decoration: none; }
  .brand .mark { width: 44px; height: 44px; flex: none; }
  .brand .words { line-height: 1.1; }
  .brand .w1 { font-family: var(--serif); font-weight: 700; font-size: 1.3rem; letter-spacing: .02em; color: var(--green); display: block; }
  .brand .w2 { font-size: .72rem; letter-spacing: .28em; color: var(--gold); font-weight: 600; display: block; margin-top: 3px; }
  @media (prefers-color-scheme: dark) { .brand .w1 { color: var(--ink); } }
  .actions { display: flex; align-items: center; gap: .6rem; }
  .shoplink { text-decoration: none; font-weight: 600; padding: .5rem .8rem; }
  .shoplink:hover { text-decoration: underline; text-underline-offset: 6px; text-decoration-color: var(--gold); text-decoration-thickness: 2px; }
  @media (max-width: 640px) { .shoplink { display: none; } .brand .w2 { letter-spacing: .18em; } }
  .cart-count { background: var(--gold-soft); color: #1B1400; min-width: 1.5rem; height: 1.5rem; border-radius: 99px; display: inline-flex; align-items: center; justify-content: center; font-size: .82rem; font-weight: 800; padding: 0 .35rem; }

  /* Dropdown */
  .dd { position: relative; }
  .dd-panel { position: absolute; right: 0; top: calc(100% + 8px); width: 290px; max-width: calc(100vw - 2rem); background: var(--surface); border: 1px solid var(--line); border-top: 3px solid var(--gold); border-radius: 4px; box-shadow: 0 18px 40px -12px rgba(0,0,0,.35); padding: .4rem 0; z-index: 50; }
  .dd-panel a, .dd-panel button.item { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: .7rem 1.1rem; min-height: 46px; text-decoration: none; background: none; border: 0; color: var(--ink); font: inherit; text-align: left; cursor: pointer; }
  .dd-panel a:hover, .dd-panel button.item:hover { background: var(--bg); }
  .dd-label { padding: .6rem 1.1rem .2rem; font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); font-weight: 700; }
  .dd-panel hr { border: 0; border-top: 1px solid var(--line); margin: .4rem 0; }
  .dd-panel .sub { padding-left: 1.8rem; font-size: .95rem; }
  .dd-caret { font-size: .7rem; }

  /* Hero */
  .hero { position: relative; overflow: hidden; background: var(--surface); border-bottom: 1px solid var(--line); padding: clamp(2.5rem, 7vw, 5rem) 0; }
  .hero::before { content: ""; position: absolute; right: -120px; top: -80px; width: 560px; height: 560px; background: radial-gradient(circle, rgba(176,138,46,.10), transparent 65%); pointer-events: none; }
  .hero-grid { position: relative; display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .hero .kicker { color: var(--gold); font-weight: 700; letter-spacing: .06em; margin-bottom: 1rem; }
  .hero p.lead { font-size: 1.15rem; color: var(--muted); max-width: 33rem; }
  .hero .cta { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.8rem; }
  .hero-visual { position: relative; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; background: #fff; box-shadow: var(--shadow); }
  .hero-visual svg { width: 100%; height: auto; }
  .hero-visual img.photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; } }

  .stats { background: var(--green); color: #fff; }
  .stats ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .stats li { padding: 1.3rem 1.25rem; border-left: 1px solid rgba(255,255,255,.14); }
  .stats li:first-child { border-left: 0; }
  .stats b { display: block; font-family: var(--serif); font-size: 1.7rem; color: var(--gold-soft); line-height: 1.1; }
  .stats span { font-size: .93rem; opacity: .85; }
  @media (max-width: 640px) { .stats li { border-left: 0; border-top: 1px solid rgba(255,255,255,.14); } .stats li:first-child { border-top: 0; } }

  section { scroll-margin-top: 90px; }
  .shop { padding: clamp(3rem, 7vw, 5rem) 0; }
  .shop-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.2rem; margin-bottom: 1.6rem; }
  .shop-head p { color: var(--muted); max-width: 34rem; }
  .search input { font: inherit; width: 100%; min-width: 250px; min-height: 48px; padding: .6rem 1rem; border: 1.5px solid var(--line); background: var(--surface); color: var(--ink); border-radius: 4px; }
  .search input:focus { border-color: var(--green-2); outline: none; }
  .chips { display: flex; flex-wrap: wrap; gap: .45rem; margin-bottom: 1.6rem; border-bottom: 1px solid var(--line); padding-bottom: 1.1rem; }
  .chip { font: inherit; font-weight: 600; cursor: pointer; min-height: 42px; padding: .35rem 1rem; border-radius: 4px; border: 1.5px solid var(--line); background: var(--surface); color: var(--ink); }
  .chip:hover { border-color: var(--green-2); }
  .chip[aria-pressed="true"] { background: var(--green); color: #fff; border-color: var(--green); }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(255px, 1fr)); gap: 1.25rem; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 6px; overflow: hidden; display: flex; flex-direction: column; }
  .card:hover { box-shadow: var(--shadow); }
  .art { position: relative; height: 200px; display: flex; align-items: center; justify-content: center; background: #F1EFE6; overflow: hidden; }
  .art svg.sack { height: 168px; width: auto; }
  .art img.photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .badge { position: absolute; top: .6rem; left: .6rem; z-index: 2; background: var(--green); color: #fff; font-size: .74rem; font-weight: 600; letter-spacing: .04em; padding: .2rem .6rem; border-radius: 3px; }
  .badge.out { background: var(--danger); color: #fff; left: auto; right: .6rem; }
  .card-body { padding: 1rem 1.1rem 1.2rem; display: flex; flex-direction: column; gap: .65rem; flex: 1; }
  .card-body .cat { font-size: .85rem; color: var(--gold); font-weight: 700; letter-spacing: .03em; }
  .card-body .desc { color: var(--muted); font-size: .94rem; }
  .buy { margin-top: auto; display: grid; gap: .65rem; padding-top: .4rem; border-top: 1px solid var(--line); }
  .price { font-family: var(--serif); font-weight: 700; font-size: 1.45rem; }
  .price small { font-family: system-ui, sans-serif; font-weight: 500; font-size: .84rem; color: var(--muted); }
  select, .field input, .field textarea, .dash input[type=number], .dash input[type=text], .dash input[type=password] { font: inherit; color: var(--ink); background: var(--bg); border: 1.5px solid var(--line); border-radius: 4px; min-height: 44px; padding: .45rem .7rem; width: 100%; }
  select:focus, .field input:focus, .field textarea:focus, .dash input:focus { border-color: var(--green-2); outline: none; }
  .empty { padding: 2.5rem 1rem; text-align: center; color: var(--muted); border: 1.5px dashed var(--line); border-radius: 6px; grid-column: 1 / -1; }
  .note { margin-top: 1.4rem; font-size: .92rem; color: var(--muted); }

  .how { background: var(--surface); border-block: 1px solid var(--line); padding: clamp(3rem, 7vw, 5rem) 0; }
  .steps { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; counter-reset: step; }
  .steps li { counter-increment: step; border-top: 3px solid var(--green); padding-top: 1rem; }
  .steps li::before { content: "0" counter(step); font-family: var(--serif); font-size: 1.8rem; color: var(--gold); display: block; margin-bottom: .3rem; }
  .steps h3 { margin-bottom: .4rem; }
  .steps p { color: var(--muted); }

  .about { padding: clamp(3rem, 7vw, 5rem) 0; }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 5vw, 4rem); align-items: start; }
  .about p { color: var(--muted); max-width: 35rem; }
  .about p + p { margin-top: 1rem; }
  .commit { margin: 0; display: grid; gap: 0; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); }
  .commit > div { padding: 1.05rem 1.3rem; border-top: 1px solid var(--line); }
  .commit > div:first-child { border-top: 0; }
  .commit dt { font-weight: 700; font-family: var(--serif); }
  .commit dd { margin: .2rem 0 0; color: var(--muted); }
  @media (max-width: 800px) { .about-grid { grid-template-columns: 1fr; } }

  .contact { background: var(--surface); border-top: 1px solid var(--line); padding: clamp(2.5rem, 6vw, 4rem) 0; }
  .contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-top: 1.6rem; }
  .contact-grid h3 { margin-bottom: .3rem; }
  .contact-grid p { color: var(--muted); }

  footer { background: var(--green); color: #E8EFE6; padding: 2.2rem 0; border-top: 4px solid var(--gold); }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.5rem; }
  footer .w1 { font-family: var(--serif); font-size: 1.3rem; font-weight: 700; color: #fff; }
  footer p { opacity: .8; max-width: 28rem; margin-top: .3rem; }
  footer .links { display: flex; gap: 1.4rem; flex-wrap: wrap; align-items: flex-start; }
  footer .links a { text-decoration: none; opacity: .9; }
  footer .links a:hover { text-decoration: underline; }
  .copy { margin-top: 1.6rem; font-size: .88rem; opacity: .65; }

  /* Cart drawer */
  .overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(6,10,8,.6); opacity: 0; visibility: hidden; transition: opacity .2s, visibility .2s; z-index: 55; }
  .overlay.open { opacity: 1; visibility: visible; }
  .drawer { position: fixed; top: 0; right: 0; height: 100vh; width: 100%; max-width: 440px; background: var(--bg); z-index: 60; display: flex; flex-direction: column; transform: translateX(100%); visibility: hidden; transition: transform .25s ease, visibility .25s; border-left: 1px solid var(--line); }
  .drawer.open { transform: translateX(0); visibility: visible; }
  .drawer-head { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.2rem; border-bottom: 1px solid var(--line); background: var(--surface); }
  .drawer-body { flex: 1; overflow-y: auto; padding: 1rem 1.2rem; }
  .drawer-foot { border-top: 1px solid var(--line); padding: 1rem 1.2rem 1.2rem; background: var(--surface); }
  .line-item { display: grid; grid-template-columns: 1fr auto; gap: .3rem .8rem; padding: .9rem 0; border-bottom: 1px solid var(--line); }
  .line-item .t { font-weight: 700; }
  .line-item .s { color: var(--muted); font-size: .92rem; }
  .line-item .p { font-weight: 700; text-align: right; }
  .qty { display: inline-flex; align-items: center; border: 1.5px solid var(--line); border-radius: 4px; overflow: hidden; }
  .qty button { font: inherit; font-weight: 700; width: 44px; height: 44px; border: 0; background: transparent; color: var(--ink); cursor: pointer; }
  .qty span { min-width: 2rem; text-align: center; font-weight: 600; }
  .link-btn { font: inherit; background: none; border: 0; color: var(--muted); text-decoration: underline; cursor: pointer; min-height: 44px; padding: 0 .4rem; }
  .icon-btn { font: inherit; width: 44px; height: 44px; border-radius: 4px; border: 1.5px solid var(--line); background: transparent; color: var(--ink); cursor: pointer; font-size: 1.3rem; }
  .totals { display: flex; justify-content: space-between; font-family: var(--serif); font-weight: 700; font-size: 1.3rem; margin-bottom: .8rem; }
  .field { display: grid; gap: .25rem; margin-bottom: .7rem; }
  .field label { font-weight: 600; font-size: .93rem; }
  .field textarea { min-height: 70px; resize: vertical; }
  .error { color: var(--danger); font-size: .92rem; min-height: 1.3em; margin-bottom: .4rem; }
  .fine { font-size: .85rem; color: var(--muted); margin-top: .6rem; }
  .toast { position: fixed; left: 50%; bottom: 1.4rem; transform: translate(-50%, 20px); background: var(--green); color: #fff; padding: .7rem 1.1rem; border-radius: 4px; border-left: 4px solid var(--gold-soft); font-weight: 600; opacity: 0; visibility: hidden; transition: opacity .2s, transform .2s, visibility .2s; z-index: 80; max-width: 92vw; }
  .toast.show { opacity: 1; visibility: visible; transform: translate(-50%, 0); }

  /* Dashboard */
  .dash { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 70; background: var(--bg); overflow-y: auto; }
  .dash-top { background: var(--green); color: #fff; border-bottom: 4px solid var(--gold); position: sticky; top: 0; z-index: 2; }
  .dash-top .wrap { display: flex; align-items: center; justify-content: space-between; min-height: 64px; gap: 1rem; }
  .dash-top h2 { font-size: 1.3rem; color: #fff; }
  .dash-top .btn-outline { color: #fff; border-color: rgba(255,255,255,.6); }
  .dash-top .btn-outline:hover { background: #fff; color: var(--green); }
  .dash-main { padding: 1.5rem 0 3rem; }
  .gate { max-width: 380px; margin: 3rem auto; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 1.6rem; }
  .gate p { color: var(--muted); margin: .5rem 0 1rem; }
  .tabs { display: flex; gap: .4rem; flex-wrap: wrap; margin-bottom: 1.4rem; border-bottom: 1px solid var(--line); }
  .tab { font: inherit; font-weight: 600; background: none; border: 0; border-bottom: 3px solid transparent; padding: .7rem 1rem; min-height: 46px; cursor: pointer; color: var(--muted); }
  .tab[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--gold); }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 1rem; }
  .kpi { background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 1.1rem 1.2rem; border-top: 3px solid var(--green); }
  .kpi b { display: block; font-family: var(--serif); font-size: 1.8rem; line-height: 1.15; }
  .kpi span { color: var(--muted); font-size: .92rem; }
  .panel { background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 1.1rem 1.2rem; margin-top: 1.2rem; }
  .prow { display: grid; grid-template-columns: 1fr 130px 90px; gap: .7rem; align-items: center; padding: .6rem 0; border-bottom: 1px solid var(--line); }
  .prow.head { font-size: .78rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 700; }
  .prow label.tg { display: flex; align-items: center; gap: .4rem; cursor: pointer; min-height: 44px; }
  .prow input[type=checkbox] { width: 22px; height: 22px; }
  .order { padding: .9rem 0; border-bottom: 1px solid var(--line); }
  .order .meta { color: var(--muted); font-size: .9rem; }
  .order ul { margin: .4rem 0 0; padding-left: 1.1rem; }
  .dash .field { max-width: 420px; }

  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .drawer, .overlay, .toast { transition: none; } }
</style>
</head>
