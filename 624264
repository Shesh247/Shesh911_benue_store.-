<header class="site">
  <div class="wrap bar">
    <a class="brand" href="#top" aria-label="Shesh911 Benue Store, home">
      <svg class="mark" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="24" fill="#0F3D2B"/><circle cx="24" cy="24" r="21.3" fill="none" stroke="#D4AF55" stroke-width="1.4"/><use href="#emblem" x="9" y="9" width="30" height="30" color="#FFFFFF"/></svg>
